TON_VIB(IN := M2_VIB > 7.2, PT := T#10S);
IF TON_VIB.Q THEN
    M2_FLT := TRUE;
END_IF;
IF M2_FLT THEN
    M2_RUN := FALSE;
    M2_SPD := 0.0;
ELSIF NOT B3:3/0 THEN
    M2_SPD := 120.0;
ELSE
    M2_RUN := TRUE;
    M2_SPD := 300.0;
END_IF;
IF M2_RUN THEN
    M2_P_FILL := 2.5;
ELSE
    M2_P_FILL := 0.2;
END_IF;
